{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truewords-review-sync",
  "main": "src/worker-source-integrity-v4.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truewords-review-sync-db"
    }
  ],
  "vars": {
    "ACTIVE_DATASET_ID": "philena-2026-pilot-v4-unseen"
  }
}
