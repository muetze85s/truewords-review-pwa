{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truewords-review-sync",
  "main": "src/worker-d1.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "review.truewords-paaruebersetzer.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truewords-review-sync-db"
    }
  ],
  "vars": {
    "ACTIVE_DATASET_ID": "philena-2026"
  }
}
