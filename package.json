{
  "name": "truewords-review-pwa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "check": "node --check server-sync.js && node --check admin-upload.js && node --check analysis-import.js && node --check scripts/build-worker.mjs && node --check scripts/import-review-data.mjs && tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "import:data": "node scripts/import-review-data.mjs",
    "db:migrate:local": "wrangler d1 migrations apply truewords-review-sync-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply truewords-review-sync-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.92.0"
  }
}
